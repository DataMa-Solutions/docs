---
// Content that applies to some environments only:
//   <Env only="tableau powerbi">…</Env>
import { ENVIRONMENT_IDS, environmentLabel } from '../lib/environments';

interface Props {
	only: string;
}

const ids = Astro.props.only.split(/[\s,]+/).filter(Boolean);
const unknown = ids.filter((id) => !(ENVIRONMENT_IDS as readonly string[]).includes(id));
if (unknown.length) throw new Error(`<Env only>: unknown environment(s) ${unknown.join(', ')}`);
---

<div class="env-block" data-envs={ids.join(' ')}>
	<p class="env-label">{ids.map(environmentLabel).join(', ')}</p>
	<slot />
</div>

<style>
	.env-block {
		border-left: 3px solid var(--sl-color-accent);
		padding-left: 1rem;
	}
	.env-label {
		font-size: var(--sl-text-xs);
		text-transform: uppercase;
		letter-spacing: 0.04em;
		color: var(--sl-color-gray-3);
	}
</style>
