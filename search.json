---
---
[
  {% for page in site.pages %}
    {% if page.url contains '.js' %}
      {% continue %}
    {% endif %}
    {% if page.url contains '.json' %}
      {% continue %}
    {% endif %}
    {% if page.url contains '.xml' %}
      {% continue %}
    {% endif %}
    {% if page.url contains 'totw' %}
      {% continue %}
    {% endif %}
    {% if page.url contains 'ucotm' %}
      {% continue %}
    {% endif %}
    {% if page.url contains 'release' %}
      {% continue %}
    {% endif %}
    {% if page.url contains 'tip_of_' %}
      {% continue %}
    {% endif %}
    {% comment %} Same values as before, but passed through jsonify so that
       backslashes and control characters in a page cannot break the JSON
       (one invalid page used to disable the whole search). {% endcomment %}
    {% capture s_title %}{{ page.title | escape }}{% endcapture %}
    {% capture s_scope %}{{ page.scope }}{% endcapture %}
    {% capture s_tags %}{{ page.tags }}{% endcapture %}
    {% capture s_keywords %}{{ page.keywords }}{% endcapture %}
    {% capture s_description %}{{ page.description | strip | escape }}{% endcapture %}
    {% capture s_body %}{{ page.content | strip_newlines | replace: '"', "'" | newline_to_br | strip_newlines | replace: '<br />', ' ' | strip_html | strip | escape }}{% endcapture %}
    {
      "title": {{ s_title | jsonify }},
      "scope": {{ s_scope | jsonify }},
      "tags": {{ s_tags | jsonify }},
      "keywords": {{ s_keywords | jsonify }},
      "description": {{ s_description | jsonify }},
      "url": "{{site.url}}{{site.baseurl}}{{page.url}}",
      "body": {{ s_body | jsonify }}
    } {% unless forloop.last %},{% endunless %}
  {% endfor %}
]
